# Configuration locale de GamestackrTCG.
# Les lignes commençant par # sont des commentaires ou des options désactivées.
# .env contient les valeurs propres au poste ; .env.example sert de modèle sans secrets.

# -----------------------------------------------------------------------------
# Application et ports locaux
# -----------------------------------------------------------------------------
# Les ports publiés par Docker sont limités à 127.0.0.1 (cet ordinateur).

# Nom de l’application, repris notamment dans les e-mails et le nom du cookie de session.
APP_NAME=GamestackrTCG
# Port du site sur ton ordinateur : http://localhost:8000 par défaut. Adapter aussi APP_URL.
APP_PORT=8000
# Port du serveur frontend Vite et de son rechargement automatique en développement.
VITE_PORT=5173
# Port de l’interface de consultation des e-mails : http://localhost:8025 par défaut.
MAILPIT_PORT=8025
# Port PostgreSQL accessible depuis ton ordinateur (ex. DBeaver), distinct du DB_PORT interne.
DB_FORWARD_PORT=5432
# Port de l’API S3 depuis ton ordinateur ; Laravel utilise en interne http://garage:3900.
GARAGE_API_PORT=3900
# Port de lecture des images dans le navigateur : http://<bucket>.localhost:3902 par défaut.
GARAGE_WEB_PORT=3902
# Port de l’interface Garage Web UI : http://localhost:3909 par défaut.
GARAGE_UI_PORT=3909
# Nom du bucket créé dans Garage par make storage-init ; changer ce nom ne déplace pas les images.
GARAGE_BUCKET=gamestackr-images
# Environnement Laravel : local pour le développement, production pour un déploiement réel.
APP_ENV=local
# Clé secrète de chiffrement Laravel, générée par make init ; conserver la clé d’une installation existante.
APP_KEY=
# Affiche les détails des erreurs quand true ; utiliser false en production.
APP_DEBUG=true
# URL complète du site : liens générés et origine autorisée par le CORS Garage.
APP_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Langues et données de test
# -----------------------------------------------------------------------------

# Langue des messages Laravel traduisibles ; ne remplace pas les libellés français écrits dans React.
APP_LOCALE=en
# Langue de secours lorsqu’une traduction manque dans APP_LOCALE.
APP_FALLBACK_LOCALE=en
# Langue et région des fausses données générées par les factories et les tests.
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Maintenance et serveur de développement
# -----------------------------------------------------------------------------

# Stockage du mode maintenance (artisan down/up) : file local, ou cache pour plusieurs instances.
APP_MAINTENANCE_DRIVER=file
# Cache utilisé uniquement si APP_MAINTENANCE_DRIVER=cache ; database utilise PostgreSQL.
# APP_MAINTENANCE_STORE=database

# Nombre de processus du serveur PHP de développement ; plusieurs nécessitent artisan serve --no-reload.
# PHP_CLI_SERVER_WORKERS=4

# -----------------------------------------------------------------------------
# Mots de passe
# -----------------------------------------------------------------------------

# Coût du hachage des mots de passe : une valeur plus élevée augmente le temps de calcul.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Journaux
# -----------------------------------------------------------------------------

# Destination principale des logs ; stack regroupe les canaux indiqués dans LOG_STACK.
LOG_CHANNEL=stack
# Canaux séparés par des virgules ; single écrit dans storage/logs/laravel.log.
LOG_STACK=single
# Destination des avertissements de dépréciation ; null les ignore.
LOG_DEPRECATIONS_CHANNEL=null
# Sévérité minimale enregistrée : debug est le plus détaillé, puis info, warning, error, etc.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# Ces valeurs configurent Laravel et initialisent PostgreSQL si son volume est neuf.
# Les modifier ne recrée pas la base ni les utilisateurs d’un volume existant.

# Pilote de base de données ; pgsql sélectionne PostgreSQL.
DB_CONNECTION=pgsql
# Adresse vue par Laravel dans Docker : postgres est le nom du service, pas localhost.
DB_HOST=postgres
# Port PostgreSQL dans le réseau Docker (5432), indépendant de DB_FORWARD_PORT.
DB_PORT=5432
# Nom de la base applicative ; les tests utilisent une base séparée définie dans phpunit.xml.
DB_DATABASE=gamestackr
# Utilisateur PostgreSQL utilisé par Laravel et créé au premier démarrage du volume.
DB_USERNAME=gamestackr
# Mot de passe PostgreSQL ; modifier cette valeur ne change pas le mot de passe d’un compte existant.
DB_PASSWORD=local-development-only

# -----------------------------------------------------------------------------
# Sessions et cookies
# -----------------------------------------------------------------------------

# Stockage des sessions ; database utilise la table sessions de PostgreSQL.
SESSION_DRIVER=database
# Durée d’inactivité maximale d’une session, en minutes.
SESSION_LIFETIME=120
# Chiffre le contenu des sessions stockées quand true ; indépendant du HTTPS.
SESSION_ENCRYPT=false
# Chemin couvert par le cookie de session ; / le rend disponible sur tout le site.
SESSION_PATH=/
# Domaine du cookie de session ; null le limite à l’hôte qui sert le site.
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Fichiers, événements et tâches en arrière-plan
# -----------------------------------------------------------------------------

# Option de diffusion d’événements en temps réel ; inutilisée ici tant que le broadcasting n’est pas configuré.
BROADCAST_CONNECTION=log
# Disque des fichiers généraux ; local correspond à storage/app/private, indépendamment des images des jeux.
FILESYSTEM_DISK=local
# Disque des images des jeux : s3 pour Garage, public pour storage/app/public ; migrer avant de changer.
GAME_IMAGES_DISK=s3
# Stockage des tâches en arrière-plan ; database utilise PostgreSQL, exécuté par le service Docker queue.
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# Stockage du cache Laravel ; database utilise PostgreSQL, sans service Redis nécessaire.
CACHE_STORE=database
# Préfixe des clés pour les stores qui le prennent en charge ; par défaut, dérivé de APP_NAME.
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Memcached et Redis : alternatives facultatives, non utilisées par défaut
# -----------------------------------------------------------------------------

# Adresse Memcached si CACHE_STORE=memcached ; aucun service Memcached n’est fourni dans ce Docker.
MEMCACHED_HOST=127.0.0.1

# Client PHP Redis (phpredis utilise l’extension PHP) ; sans effet tant qu’aucun service n’utilise Redis.
REDIS_CLIENT=phpredis
# Adresse Redis vue depuis Laravel ; 127.0.0.1 désigne le conteneur app, pas ton ordinateur.
REDIS_HOST=127.0.0.1
# Mot de passe Redis ; null signifie sans authentification.
REDIS_PASSWORD=null
# Port du serveur Redis ; aucun service Redis n’est fourni dans ce Docker.
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# E-mails de développement avec Mailpit
# -----------------------------------------------------------------------------

# Transport des e-mails ; smtp utilise le serveur défini ci-dessous, log écrit les messages dans les logs.
MAIL_MAILER=smtp
# Schéma SMTP (smtp ou smtps) ; null laisse le transport choisir selon le port, adapté à Mailpit local.
MAIL_SCHEME=null
# Serveur SMTP vu depuis Laravel ; mailpit capture les e-mails localement sans les envoyer sur Internet.
MAIL_HOST=mailpit
# Port SMTP interne de Mailpit (1025), distinct de MAILPIT_PORT qui sert son interface web.
MAIL_PORT=1025
# Identifiant SMTP ; null convient au Mailpit local sans authentification.
MAIL_USERNAME=null
# Mot de passe SMTP ; null convient au Mailpit local sans authentification.
MAIL_PASSWORD=null
# Adresse d’expédition affichée dans les e-mails de l’application.
MAIL_FROM_ADDRESS="hello@gamestackr.test"
# Nom d’expéditeur affiché ; ${APP_NAME} reprend le nom de l’application.
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Stockage compatible S3 : Garage local ou fournisseur externe
# -----------------------------------------------------------------------------
# Les valeurs AWS_* non vides ci-dessous ont priorité sur storage/app/private/garage/s3.json.
# Pour Garage, les champs vides reprennent les accès générés ; aucun compte Amazon n’est nécessaire.
# Pour un fournisseur externe, renseigner une configuration complète et cohérente.
# Ces variables ne sont pas les identifiants Web UI : voir storage/app/private/garage/login.txt.

# Identifiant S3 ; laisser vide pour utiliser la clé locale générée par make storage-init.
AWS_ACCESS_KEY_ID=
# Secret S3 associé ; laisser vide pour utiliser le secret local généré, conservé hors de Git.
AWS_SECRET_ACCESS_KEY=
# Région de signature S3, également configurée dans Garage ; après modification, faire make down puis make up.
AWS_DEFAULT_REGION=garage
# Bucket utilisé par Laravel ; vide reprend le bucket Garage généré à partir de GARAGE_BUCKET.
AWS_BUCKET=
# URL de l’API S3 vue par Laravel ; vide reprend http://garage:3900, sans nom de bucket dans l’URL.
AWS_ENDPOINT=
# URL publique de base des images ; vide reprend http://<GARAGE_BUCKET>.localhost:<GARAGE_WEB_PORT>.
AWS_URL=
# true place le bucket dans le chemin des requêtes S3 ; forcé à true si AWS_ENDPOINT est absent ou vide.
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# Configuration frontend exposée au navigateur
# -----------------------------------------------------------------------------
# Les variables VITE_* sont publiques : ne jamais y placer de secret.
# Après modification, redémarrer Vite ou recompiler les assets.

# Nom transmis au frontend pour le titre des pages ; ${APP_NAME} reprend le nom Laravel.
VITE_APP_NAME="${APP_NAME}"
